{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fos-rag:knowledge-feed:v1",
  "title": "FOS Knowledge Feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "fos-rag-feed/v1"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
    "cursor": {"type": "string", "maxLength": 2048},
    "items": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\x00-\\x1f]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\x00-\\x1f]+$"},
          "content": {"type": "string", "minLength": 1, "maxLength": 100000},
          "format": {"enum": ["markdown", "text"], "default": "markdown"},
          "source_url": {"type": "string", "maxLength": 2000, "pattern": "^https?://[^\\s]+$"},
          "updated_at": {"type": "string", "format": "date-time"},
          "fields": {"type": "object", "description": "Scalar field values shown as tracker-table columns. At most 20,000 serialized JSON characters per record, including keys and structure."},
          "metadata": {"type": "object", "description": "At most 20,000 serialized JSON characters per record, including keys and structure."}
        }
      }
    },
    "deleted": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
  }
}
