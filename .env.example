# FOS_RAG 本地配置示例 —— 复制为 .env 并填入真实值

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ---- MinerU OCR（PDF → Markdown，本地 API）----
MINERU_API_BASE=http://localhost:8888
MINERU_API_KEY=
MINERU_BACKEND=pipeline
MINERU_LANG=ch

# ---- Embedding（OpenAI 兼容接口）----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560

# ---- LLM（OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-key
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2

# ---- 检索参数 ----
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_TOP_K=3

# ---- Rerank（重排序；启用开关在 /kb/settings/ 页，.env 不控制）----
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# WeMM 在本机负载高时逐条计算；小批次避免超时（原生与 OpenAI 兼容接口通用）
WEMM_BATCH_SIZE=4
WEMM_REQUEST_TIMEOUT=180
