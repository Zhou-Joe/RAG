# FOS_RAG 本地配置示例 —— 复制为 .env 并填入真实值

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# Optional canonical app URL for report links (e.g. FRP public host and port).
# Otherwise detected from the external request and retained for cron jobs.
FEED_REPORT_PUBLIC_BASE=
# Enable only when your trusted reverse proxy overwrites forwarded host/protocol.
DJANGO_TRUST_PROXY_HEADERS=False

# ---- MinerU OCR（PDF → Markdown，HTTP API；4.0.x 与 4.1.x 自动识别）----
MINERU_API_BASE=http://localhost:8888
MINERU_API_KEY=
# 解析档位：standard / flash / basic / advanced（留空＝standard）。
# 旧值仍可用：pipeline→standard、vlm→flash。
MINERU_BACKEND=pipeline
# 已废弃：4.x 不再接收语言参数，留着只为兼容旧配置。
MINERU_LANG=ch

# ---- Embedding（OpenAI 兼容接口）----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560

# ---- LLM（OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-key
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2
# 回答模型的输出预算（max_tokens）。不设则为代码默认 2048。
# 思考型模型的思维链算在输出预算里，2048 常导致正文被截断（界面提示「模型输出被截断」），建议 8192-16384。
LLM_MAX_OUTPUT_TOKENS=16384
# 一整轮问答的超时（秒）。输出预算调大后应同步调大，否则长回答先超时。
QA_TURN_TIMEOUT=600

# ---- 检索参数 ----
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_TOP_K=3

# ---- Rerank（重排序；启用开关在 /kb/settings/ 页，.env 不控制）----
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# WeMM 在本机负载高时逐条计算；小批次避免超时（原生与 OpenAI 兼容接口通用）
WEMM_BATCH_SIZE=4
WEMM_REQUEST_TIMEOUT=180

# Optional API-fed knowledge bases. Map a header to this variable name in the
# source configuration; use a real value only in the deployment's private .env.
# FOS_FEED_REPORT_AUTH=Bearer replace-with-upstream-api-token
# Optional connector-builder web search (otherwise public DuckDuckGo HTML).
# FOS_FEED_SEARCH_URL=https://search.example.com/search
# FOS_FEED_SEARCH_API_KEY=replace-with-tavily-key
# Optional: an existing Chromium/Edge executable for webpage collectors.
# Windows normally reuses installed Edge; other hosts can run python -m playwright install chromium.
# FOS_BROWSER_EXECUTABLE=/absolute/path/to/chromium
